mixin picture(opts)
  -
    const name = opts.name;
    const alt = opts.alt || '';
    const width = opts.width;
    const height = opts.height;
    const eager = Boolean(opts.eager);
    const sizes = opts.sizes || '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw';
    const imgClass = opts.imgClass || '';
    const styleAttr = opts.color ? `--c:${opts.color}` : null;
  picture
    source(
      type='image/avif',
      srcset=`/assets/images/${name}-400.avif 400w, /assets/images/${name}-800.avif 800w`,
      sizes=sizes
    )
    source(
      type='image/webp',
      srcset=`/assets/images/${name}-400.webp 400w, /assets/images/${name}-800.webp 800w`,
      sizes=sizes
    )
    if eager
      img(
        class=imgClass,
        src=`/assets/images/${name}-800.jpg`,
        alt=alt,
        width=width,
        height=height,
        decoding='async',
        style=styleAttr
      )&attributes(attributes)
    else
      img(
        class=imgClass,
        src=`/assets/images/${name}-800.jpg`,
        alt=alt,
        width=width,
        height=height,
        loading='lazy',
        decoding='async',
        style=styleAttr
      )&attributes(attributes)
