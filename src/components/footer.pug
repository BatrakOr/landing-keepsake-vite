//- src/components/footer.pug
footer.footer
  .container
    .footer__top
      .fcols
        each col in footerColumns
          nav(aria-label=col.title)
            h2 #{ col.title }
            ul
              each link in col.links
                li
                  a(href=link.href) #{ link.label }
      #subscribe.sub
        h2 Newsletter
        form.sub__form(action='#subscribe')
          p Fresh case studies and design notes, once a month.
          .sub__row
            label.vh(for='email') Email address
            input#email(
              type='email',
              name='email',
              placeholder='Your email address',
              required,
              aria-describedby='email-err'
            )
            button.btn(type='submit') Subscribe
          p#email-err.err Enter a valid email address, like name@example.com.
          label.agree
            input(type='checkbox', required)
            |
            | I agree to the privacy policy
        p.ok(role='status') Thank you! You're subscribed.
    .footer__bot
      p #{ site.copyright }
      .social(aria-label='Social networks')
        each soc in socials
          a(href=soc.href, aria-label=soc.name, style=`--c:${soc.color}`) #{ soc.letter }
